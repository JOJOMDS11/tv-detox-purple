# Preferir usar DATABASE_URL quando o banco for Postgres/Supabase
DATABASE_URL=postgresql://postgres:SEU_PASSWORD@SEU_HOST:5432/postgres?sslmode=require
ADMIN_PASSWORD=sua_senha_forte
NODE_ENV=production

# Alternativa direta (caso prefira preencher cada variável separadamente)
# DB_HOST=SEU_HOST
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=SEU_PASSWORD
# DB_NAME=postgres
# DB_SSL=true
# DB_POOL_MAX=3

